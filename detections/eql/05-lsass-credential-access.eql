any where event.code == "10"
  and winlog.event_data.TargetImage : "*\\lsass.exe"
  and winlog.event_data.GrantedAccess : ("0x1010", "0x1410", "0x1438", "0x143a", "0x1fffff")
  and not (process.executable : ("*\\Windows\\System32\\*", "*\\Windows\\SysWOW64\\*")
           and process.name : ("svchost.exe", "lsass.exe", "csrss.exe", "services.exe",
                               "wininit.exe", "wmiprvse.exe", "wsmprovhost.exe"))
  and not (process.executable : ("*\\Program Files\\Elastic\\*", "*\\ProgramData\\Elastic\\*"))
