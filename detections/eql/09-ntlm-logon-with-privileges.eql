sequence by winlog.event_data.TargetUserName with maxspan=5m
  [any where event.code == "4624"
     and winlog.event_data.LogonType in ("3", "10")
     and not winlog.event_data.TargetUserName : "*$"]
  [any where event.code == "4672"
     and not winlog.event_data.SubjectUserName : ("*$", "SYSTEM", "LOCAL SERVICE", "NETWORK SERVICE")]
