# Runtime and secret material lives only in these paths. Everything else is source and is tracked.
# File-name globs such as *password* or *credential* are deliberately NOT used: they match detection
# rules whose subject is credential access and silently drop them from the package.

# local operator state (credentials, plans, scratch builds)
/stage/
/_local/
/build/
/out/
*.pid

# C2 material that must never be published
/infra/c2/private/
/infra/c2/certs/

# key material anywhere
*.pem
*.key
*.p12
*.pfx
*.jks

# environment files that carry secrets
.env
.env.*
!.env.example

# Elastic tokens and enrollment material
enrollment*
service-token*
fleet-token*

# logs and scratch files
*.log
*.tmp
*.bak
c0015-comparefor.jpg

# python caches
__pycache__/
*.pyc

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
