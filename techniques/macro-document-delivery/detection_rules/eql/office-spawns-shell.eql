// Office process starts a shell or script host.
// Fires on the first edge of the document chain, before any payload is written.
process where event.code == "1"
  and process.parent.name : ("winword.exe", "excel.exe", "powerpnt.exe", "outlook.exe")
  and process.name : ("cmd.exe", "mshta.exe", "wscript.exe", "cscript.exe", "powershell.exe")
