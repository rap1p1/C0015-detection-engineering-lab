      "kibana.alert.rule.parameters": {
        "description": "PowerShell with hidden AND (bypass|unrestricted) command-line flags, OR an encoded command (the encoded branch does not require hidden). Parent-name exclusions were removed: a parent name does not prove provenance.",
        "risk_score": 47,
        "severity": "medium",
